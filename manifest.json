{
  "manifest_version": 3,
  "name": "Kyna BBB Class Minigames & Schedule Assistant",
  "version": "1.1.0",
  "description": "Extension bộ Minigame tương tác lớp học (Đoán Chữ & Đua Bơi) và Tiện ích Đăng ký Lịch Dạy Thông minh dành cho Giáo viên Kyna English.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kyna BBB Game & Schedule Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.kynalearning.com/*",
        "https://*.kynaenglish.com/*",
        "https://*.kyna.vn/*",
        "https://*.bigbluebutton.org/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*",
        "file://*/*"
      ],
      "all_frames": true,
      "js": [
        "core/bbb-chat-observer.js",
        "core/audio-synthesizer.js",
        "games/guess-the-word/words.js",
        "games/guess-the-word/game-logic.js",
        "games/swimming-race/race-logic.js",
        "schedule/schedule-grid-selector.js",
        "schedule/schedule-sync-engine.js",
        "schedule/schedule-toolbar.js"
      ],
      "css": [
        "games/guess-the-word/game-style.css",
        "games/swimming-race/race-style.css",
        "schedule/schedule-selection.css",
        "schedule/schedule-toolbar.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sounds/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
